  issn = {15725286},
  doi = {10.1016/j.disopt.2006.05.007},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S1572528606000417},
  urldate = {2025-12-01},
  abstract = {When vehicle routing problems with additional constraints, such as capacity or time windows, are solved via column generation and branch-and-price, it is common that the pricing subproblem requires the computation of a minimum cost constrained path on a graph with costs on the arcs and prizes on the vertices. A common solution technique for this problem is dynamic programming. In this paper we illustrate how the basic dynamic programming algorithm can be improved by bounded bi-directional search and we experimentally evaluate the effectiveness of the enhancement proposed. We consider as benchmark problems the elementary shortest path problems arising as pricing subproblems in branch-and-price algorithms for the capacitated vehicle routing problem, the vehicle routing problem with distribution and collection and the capacitated vehicle routing problem with time windows.},
  langid = {english},
  keywords = {/cite},
  annotation = {TLDR: This paper illustrates how the basic dynamic programming algorithm can be improved by bounded bi-directional search and experimentally evaluates the effectiveness of the enhancement proposed.},
  file = {/Users/jiahua/Zotero/storage/YNZHN3A9/Righini and Salani - 2006 - Symmetry helps Bounded bi-directional dynamic programming for the elementary shortest path problem.pdf}
}

@article{zhaoSynchronizedDeliveriesBike2024,
  title = {Synchronized {{Deliveries}} with a {{Bike}} and a {{Self-Driving Robot}}.},
  author = {Zhao, Yanlu and Cattaruzza, Diego and Kang, Ningxuan and Roberti, Roberto},
  date = {2024-01-01},
  journaltitle = {Transportation Science},
  shortjournal = {Transportation Science},
  volume = {58},
  number = {1},
  pages = {219--239},
  publisher = {INFORMS: Institute for Operations Research \& the Management Sciences},
  issn = {0041-1655},
  doi = {10.1287/trsc.2023.0169},
  url = {https://research.ebsco.com/linkprocessor/plink?id=def09e07-983f-37c7-98af-c722f63eed65},
  urldate = {2025-11-21},
  abstract = {Online e-commerce giants are continuously investigating innovative ways to improve their practices in last-mile deliveries. Inspired by the current practices at JD.com (the largest online retailer by revenue in China), we investigate a delivery problem that we call the traveling salesman problem with bike and robot (TSPBR), where a cargo bike is aided by a self-driving robot to deliver parcels to customers in urban areas. We present two mixed-integer linear programming models and describe a set of valid inequalities to strengthen their linear relaxation. We show that these models can yield optimal solutions of TSPBR instances with up to 60 nodes. To efficiently find heuristic solutions, we also present a genetic algorithm based on a dynamic programming recursion that efficiently explores large neighborhoods. We computationally assess this genetic algorithm on instances provided by JD.com and show that high-quality solutions can be found in a few minutes of computing time. Finally, we provide some managerial insights to assess the impact of deploying the bike-and-robot tandem to deliver parcels in the TSPBR setting.},
  langid = {english},
  keywords = {/cite,China,Couriers and Express Delivery Services,Cycling,Delivery of goods,Driverless cars,Express service (Delivery of goods),Genetic algorithms,Genetic programming,Linear programming,Traveling salesman problem},
  annotation = {TLDR: Two mixed-integer linear programming models are presented and a set of valid inequalities to strengthen their linear relaxation are described and it is shown that these models can yield optimal solutions of TSPBR instances with up to 60 nodes.},
  file = {/Users/jiahua/Zotero/storage/3GR3U934/Zhao et al. - 2024 - Synchronized Deliveries with a Bike and a Self-Driving Robot..pdf}
}
